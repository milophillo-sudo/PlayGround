  "type": "module",
  "bugs": {
    "url": "https://github.com/milophillo-sudo/PlayGround/issues"
  },
  "homepage": "https://github.com/milophillo-sudo/PlayGround#readme",
  "dependencies": {
    "three": "^0.180.0",
    "vite": "^7.3.6"
  }
}
